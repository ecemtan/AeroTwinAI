# AeroTwin AI - local settings template.
# Copy to .env in the repository root:   Copy-Item .env.example .env
# .env is git-ignored. Never commit it. Real environment variables override it.

# --- Backend (FastAPI) --------------------------------------------------------
# Allowed browser origins (JSON list). Default: Vite dev server on 5173.
# AEROTWIN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- OpenVSP / VSPAERO --------------------------------------------------------
# Folder of an OpenVSP installation containing vspaero.exe and vspscript.exe
# OPENVSP_ROOT=C:\Tools\OpenVSP-3.x-win64
# Or the solver executable directly (overrides OPENVSP_ROOT)
# VSPAERO_EXE=C:\Tools\OpenVSP-3.x-win64\vspaero.exe

# --- JSBSim -------------------------------------------------------------------
# Only needed to use JSBSim data other than the copy bundled with the pip package
# JSBSIM_ROOT=C:\path\to\jsbsim-data

# --- Project ------------------------------------------------------------------
# Only needed when running from an installed (non-editable) package
# AEROTWIN_ROOT=C:\Users\you\AeroTwinAI
