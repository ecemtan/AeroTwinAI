# Copy to frontend/.env.local if you need to override defaults. Never commit .env.local.

# Where the Vite dev server forwards /api and /health (default: http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Absolute API base URL for builds served without the proxy (default: same origin)
# VITE_API_BASE_URL=http://127.0.0.1:8000
